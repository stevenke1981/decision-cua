# ===== 必填：OpenRouter API key（Decision-1 用；planner 也預設共用）=====
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# ===== 決策模型（Microsoft-Decision-1，走 /api/alpha/decisions）=====
DCUA_DECISION_MODEL=microsoft/microsoft-decision-1
# DCUA_DECISION_URL=https://openrouter.ai/api/alpha/decisions

# ===== Planner：任何 OpenAI 相容的聊天模型（只有 `dcua run` 需要；MCP 模式用客戶端自己的模型）=====
# 填入你要用的模型 id（OpenRouter 上的任一模型，或本地模型名稱）
DCUA_PLANNER_MODEL=
DCUA_PLANNER_BASE_URL=https://openrouter.ai/api/v1
# tools = 原生 function calling；json = 不支援 tool calling 的模型也能用
DCUA_PLANNER_PROTOCOL=tools
# DCUA_PLANNER_API_KEY=            # 空白則沿用 OPENROUTER_API_KEY
# DCUA_PLANNER_VISION=false        # true = planner 可要求帶 id 標記的截圖（需 pillow）

# --- 本地模型範例（LM Studio / Ollama / llama.cpp server）---
# DCUA_PLANNER_BASE_URL=http://localhost:1234/v1      # LM Studio
# DCUA_PLANNER_BASE_URL=http://localhost:11434/v1     # Ollama
# DCUA_PLANNER_BASE_URL=http://localhost:8080/v1      # llama.cpp server
# DCUA_PLANNER_API_KEY=local

# ===== 門檻（請用 `dcua ground "..."` 在你的 App 上實測後調整）=====
# DCUA_GROUND_MIN_PROB=0.55
# DCUA_RISK_THRESHOLD=0.5
# DCUA_VERIFY_THRESHOLD=0.5
# DCUA_INJECTION_THRESHOLD=0.7
# DCUA_DONE_THRESHOLD=0.35

# ===== 行為 =====
# DCUA_CLICK_MODE=mouse            # mouse | invoke | auto
# DCUA_VERIFY_ACTIONS=true
# DCUA_INJECTION_CHECK=true
# DCUA_AUTO_CONFIRM_RISKY=false    # 危險：跳過人工確認
# DCUA_MAX_STEPS=40
# DCUA_SETTLE_S=0.5
# DCUA_BACKEND=auto                # auto | windows | linux | fake（fake = 不碰真桌面的演示）
# DCUA_LOG_DIR=runs
